# DATABASE_URL and DATABASE_URL_UNPOOLED come from ../.env.local,
# written by `neon checkout` / `neon env pull`. Set DATABASE_URL here only to override.

# Where the web app runs: used for links in emails and to reject cross-site requests
APP_URL=http://localhost:5173

# Email. Without RESEND_API_KEY, emails (with their links) are printed to the API log.
# Resend's test sender only delivers to your own address; use a verified domain for others.
RESEND_API_KEY=
EMAIL_FROM=Subtracker <onboarding@resend.dev>

# "Continue with Google" (optional). Create an OAuth client (type: Web application) in Google
# Cloud Console with the redirect URI <APP_URL>/api/auth/google/callback. Leave both empty to
# hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Requests per 15 minutes per IP (and per email) on login, sign-up and password-reset routes
AUTH_RATE_LIMIT_MAX=10

# Background work. CRON_SECRET protects POST /api/internal/tick (the scheduled trigger);
# leave it empty to disable that endpoint. Generate one with: openssl rand -hex 32
CRON_SECRET=
# Proxies in front of the API: 0 locally, 2 for Vercel -> Render. Wrong values break rate limiting.
TRUST_PROXY=0
# How often `npm run worker` runs (seconds)
WORKER_INTERVAL_SECONDS=60

PORT=3000
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent (defaults to info, silent in tests)
LOG_LEVEL=info

# The tests read TEST_DATABASE_URL from backend/.env.test (gitignored). It must point at a
# database the tests may wipe, e.g. the Neon `test` branch: `neon connection-string test`.
